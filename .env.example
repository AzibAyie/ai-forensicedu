APP_NAME="AI-ForensicEdu"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ai_forensicedu
DB_USERNAME=root
DB_PASSWORD=

CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@forensicedu.test"
MAIL_FROM_NAME="${APP_NAME}"

# Groq AI (via a Cloudflare Worker proxy) — Required for AI case
# generation and report evaluation. The real Groq key lives only in
# the Worker's own secret store; GROQ_PROXY_SECRET just authenticates
# this app to that Worker.
GROQ_PROXY_URL=https://your-worker-subdomain.workers.dev
GROQ_PROXY_SECRET=your_proxy_shared_secret_here
GROQ_MODEL=openai/gpt-oss-120b

FILESYSTEM_DISK=local

# Uploaded question sheets and answer PDFs are stored privately under
# storage/app/ and served through authenticated routes, never public URLs.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
